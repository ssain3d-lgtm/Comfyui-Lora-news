# Copy this file to ".env" and fill in what you need. Every line is optional.
# 이 파일을 ".env" 로 복사한 뒤 필요한 값만 채우세요. 모두 선택 사항입니다.
# A variable exported in your shell always wins over this file.
# 쉘에 설정된 환경변수가 이 파일보다 우선합니다.

# --- Sources / 소스 -----------------------------------------------------
# GitHub personal access token: raises the search limit (unauthenticated = 10 requests/min)
# GitHub 토큰: 검색 API 한도 확대 (비로그인은 분당 10회)
#GITHUB_TOKEN=ghp_...

# Hugging Face token (higher rate limit)
# Hugging Face 토큰 (한도 확대)
#HF_TOKEN=hf_...

# Civitai API key (try it if you see 403 / rate-limit errors)
# Civitai API 키 (403/한도 오류가 나면 설정)
#CIVITAI_API_KEY=...

# Use only some sources: any of huggingface, github, civitai (hf / gh / cv also work)
# 일부 소스만 사용: huggingface, github, civitai 중 선택 (hf / gh / cv 도 인식)
#LORA_NEWS_SOURCES=huggingface,github

# Also fetch NSFW items from Civitai (1 = on). Off by default.
# Civitai 에서 NSFW 항목도 받아오기 (1 = 켬). 기본은 끔.
#LORA_NEWS_CIVITAI_NSFW=0

# Items per query / 쿼리당 개수
#LORA_NEWS_HF_LIMIT=100
#LORA_NEWS_GH_PER_PAGE=50
#LORA_NEWS_CIVITAI_LIMIT=100
#LORA_NEWS_README_MAX=40

# --- Claude summaries / Claude 요약 --------------------------------------
# Needs "pip install -r requirements-optional.txt"
# "pip install -r requirements-optional.txt" 가 필요합니다
#ANTHROPIC_API_KEY=sk-ant-...
#LORA_NEWS_CLAUDE=1
#LORA_NEWS_CLAUDE_MODEL=claude-opus-5
#LORA_NEWS_CLAUDE_MAX_ITEMS=60

# --- Server and behaviour / 서버와 동작 -----------------------------------
#LORA_NEWS_PORT=8765
#LORA_NEWS_HOST=127.0.0.1
#LORA_NEWS_NEW_WINDOW_HOURS=72
#LORA_NEWS_HTTP_TIMEOUT=30
#LORA_NEWS_REFRESH_DEADLINE=180
#LORA_NEWS_DATA_DIR=./data
